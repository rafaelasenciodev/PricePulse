{
  "name": "pricepulse-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "test": "vitest run",
    "test:db": "vitest run --config vitest.db.config.ts",
    "migrate": "tsx src/database/run-migrations.ts",
    "typecheck": "tsc --noEmit",
    "coverage": "vitest run --coverage --coverage.include=src --coverage.exclude=src/main.ts --coverage.reporter=text"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/pg": "^8.23.1",
    "@vitest/coverage-v8": "^4.1.12",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^4.1.12"
  },
  "dependencies": {
    "@fastify/static": "^10.1.12",
    "@fastify/swagger": "^9.9.5",
    "@fastify/swagger-ui": "^6.1.4",
    "fastify": "^5.12.8",
    "pg": "^8.23.1"
  }
}
